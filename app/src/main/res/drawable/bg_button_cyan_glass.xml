<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#8000E5FF"> <!-- Cor do efeito de clique (Ripple Ciano) -->
    <item>
        <shape android:shape="rectangle">
            <!-- Fundo translúcido (aprox 10% de opacidade no ciano) -->
            <solid android:color="#1A00E5FF" />
            <!-- Borda fina ciano neon -->
            <stroke android:width="1.5dp" android:color="#00E5FF" />
            <!-- Cantos bem arredondados -->
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>