<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_sponsor"
    android:padding="24dp">

    <!-- Tag de Destaque -->
    <TextView
        android:id="@+id/tvSponsorTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZONA PARCEIRA PATROCINADA"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botão de Fechar discreto -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#94A3B8"
        android:contentDescription="Fechar"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tvSponsorTag" />

    <!-- Nome do Estabelecimento -->
    <TextView
        android:id="@+id/tvStoreName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Nome do Estabelecimento"
        android:textColor="@color/zx_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSponsorTag" />

    <!-- Categoria / Subtítulo -->
    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Parceiro Oficial de Nutrição &amp; Bem-Estar"
        android:textColor="@color/zx_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStoreName" />

    <!-- Descrição da Recompensa -->
    <TextView
        android:id="@+id/tvRewardDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Domine o quarteirão desta área durante sua corrida para desbloquear 15% OFF em toda a linha de suplementos e isotônicos."
        android:textColor="@color/zx_text_primary"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCategory" />

    <!-- Card com Código do Cupom -->
    <TextView
        android:id="@+id/tvCouponCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_coupon_code"
        android:text="ZONEX15"
        android:textColor="#00E5FF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRewardDescription" />

    <!-- Botão de Ação -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRedeem"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_button_cyan_glass"
        android:text="RESGATAR CUPOM"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/tvCouponCode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>