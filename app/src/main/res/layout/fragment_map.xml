<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zx_map_bg">

    <!-- 1. Camada do Mapa Real (Google Maps SDK) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapContainer"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Espaçador invisível para controlar a Status Bar -->
    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botão de Configurações (Canto Superior Direito) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:backgroundTint="@color/zx_card_bg_alpha"
        app:tint="@color/zx_text_primary"
        app:fabSize="mini"
        app:elevation="0dp"
        app:borderWidth="1dp"
        app:srcCompat="@drawable/ic_settings"
        android:contentDescription="Configurações"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpacer" />

    <!-- SELETOR MINIMALISTA (Top Left) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroup"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_pill_bg"
        android:elevation="0dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@+id/btnRun"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpacer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRun"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Corrida"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/zx_text_primary"
            app:icon="@drawable/ic_run"
            app:iconSize="16dp"
            app:iconPadding="4dp"
            app:iconTint="@color/zx_text_primary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWalk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Caminhada"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/zx_text_secondary"
            app:icon="@drawable/ic_walk"
            app:iconSize="16dp"
            app:iconPadding="4dp"
            app:iconTint="@color/zx_text_secondary"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- HUD SUPERIOR FLUTUANTE (Visível apenas na Corrida Ativa) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hudCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/zx_card_bg_alpha"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/zx_border"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpacer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="00:00:00"
                android:textColor="@color/zx_primary"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"
                android:text="0.00 km"
                android:textColor="@color/zx_text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Zonas"
                        android:src="@drawable/ic_shield" />

                    <TextView
                        android:id="@+id/tvUserZones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 Conquistadas"
                        android:textColor="@color/zx_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/zx_border" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Ritmo"
                        android:src="@drawable/ic_run"
                        app:tint="@color/zx_text_secondary"/>

                    <TextView
                        android:id="@+id/tvPace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0'00&quot; /km"
                        android:textColor="@color/zx_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- GPS BOTÃO FLUTUANTE (Visível apenas na Corrida Ativa) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:backgroundTint="@color/zx_card_bg_alpha"
        app:tint="@color/zx_text_primary"
        app:fabSize="mini"
        app:elevation="4dp"
        app:borderWidth="1dp"
        app:srcCompat="@drawable/ic_gps"
        android:contentDescription="GPS"
        app:layout_constraintBottom_toTopOf="@id/btnStartRun"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTÃO INICIAR CORRIDA (SOLO FLUTUANTE) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartRun"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_btn_start_run"
        android:text="INICIAR CORRIDA"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:drawableStart="@drawable/ic_run"
        android:drawablePadding="-24dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>